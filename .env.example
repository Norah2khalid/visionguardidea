# Browser-safe Supabase settings. Leave empty to run the labeled demo mode.
# Never put the service-role key in a VITE_ variable or in frontend code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. When empty, device dispatch stays unavailable and simulation is the operating path.
# A configured URL is probed only; this build does not dispatch a physical drone.
VITE_DEVICE_GATEWAY_URL=

# Server-only, for the Supabase edge function supabase/functions/create-user.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
